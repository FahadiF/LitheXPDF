{
  "name": "lithexpdf",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "description": "Early-stage Windows PDF reader built with Rust, Tauri 2, TypeScript, and PDFium",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "worker:build:x64": "cargo build --release --target x86_64-pc-windows-msvc -p pdfium-worker",
    "worker:build:x86": "cargo build --release --target i686-pc-windows-msvc -p pdfium-worker",
    "worker:stage:x64": "node scripts/stage-worker-x64.mjs",
    "worker:stage:x86": "node scripts/stage-worker-x86.mjs",
    "release:msi": "pnpm release:msi:x64",
    "release:msi:x64": "pnpm worker:build:x64 && pnpm worker:stage:x64 && pnpm tauri build --target x86_64-pc-windows-msvc --bundles msi",
    "release:msi:x86": "pnpm worker:build:x86 && pnpm worker:stage:x86 && pnpm tauri build --target i686-pc-windows-msvc --bundles msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
