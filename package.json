{
  "name": "lithexpdf",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight Windows PDF reader scaffold",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "worker:build:windows": "cargo build --release --target x86_64-pc-windows-msvc -p pdfium-worker",
    "worker:stage:windows": "node scripts/stage-worker-windows.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
