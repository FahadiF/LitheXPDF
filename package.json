{
  "name": "lithexpdf",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Early-stage Windows PDF reader built with Rust, Tauri 2, TypeScript, and PDFium",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "worker:build:windows": "cargo build --release --target x86_64-pc-windows-msvc -p pdfium-worker",
    "worker:stage:windows": "node scripts/stage-worker-windows.mjs",
    "release:msi": "pnpm worker:build:windows && pnpm worker:stage:windows && pnpm tauri build --bundles msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
