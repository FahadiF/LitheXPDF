{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitheXPDF",
  "version": "0.1.0",
  "identifier": "app.lithexpdf.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LitheXPDF",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/pdfium-worker"]
  }
}
